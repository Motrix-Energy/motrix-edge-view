# Source is LF everywhere, regardless of the contributor's core.autocrlf.
* text=auto eol=lf

# Fixtures are bytes, not text — and that is the entire point of them.
#
# The EMS writes CRLF line terminators on every platform, a quoted CSV field can contain a
# raw CRLF, and test/fixtures.test.ts verifies each file against a SHA-256 published by the
# EMS repository. Let git normalise these and the checksums pass on Windows and fail on
# Linux CI, having "corrected" the one property the fixture exists to pin.
test/fixtures/** -text

# Brand assets are bytes. The PNG is binary either way; naming it here keeps the rule
# visible next to the fixtures one rather than relying on git's content sniffing.
docs/assets/*.png -text

# The vendored typeface. Inlined into dist/index.html at build time; a normalised
# woff2 is a corrupt woff2.
*.woff2 -text
