{
	"name": "motrix-edge-view",
	"version": "0.1.0",
	"private": true,
	"description": "Offline, single-file viewer for Motrix Edge replay output and live runtime state",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"$comment": "motrixStorageFormat is the version boundary with Motrix Edge. It must match examples/MANIFEST.json there; test/fixtures.test.ts asserts it against the vendored manifest, so a format bump fails here rather than at a user's desk.",
	"motrixStorageFormat": "1.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"fixtures:update": "node scripts/update-fixtures.mjs"
	},
	"dependencies": {
		"@lit-labs/virtualizer": "2.1.1",
		"@lit/context": "1.1.6",
		"lit": "3.3.3",
		"papaparse": "5.5.4",
		"uplot": "1.6.32"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/papaparse": "5.3.16",
		"eslint": "9.39.5",
		"jsdom": "^26.1.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.66.0",
		"vite": "7.3.6",
		"vite-plugin-singlefile": "2.3.3",
		"vitest": "3.2.7"
	}
}
